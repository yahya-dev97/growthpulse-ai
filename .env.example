# Copy to .env and fill in only what you need. Never commit .env.
# The synthetic-data path runs with every credential below left blank.

# --- Application ---
# local | test | ci | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# synthetic | live (live requires the Google Ads and Meta values below)
DATA_SOURCE=synthetic

# --- Anthropic API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Supabase PostgreSQL ---
# Use the Session pooler string from the dashboard's Connect panel (it works over IPv4),
# with the user replaced by a GrowthPulse role. URL-encode special characters in the
# password. sslmode=require is added when missing, and weaker modes are refused.
# require_auth=scram-sha-256 is always added, and other authentication methods are
# refused. For production, use sslmode=verify-full with sslrootcert set to Supabase's CA.
# Never put the postgres user or any Supabase API key here: the app refuses other roles.
#
# Backend. Must log in as growthpulse_writer. Used by the pipeline only. Shape:
#   postgresql://growthpulse_writer.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=
# Dashboard. Must log in as growthpulse_dashboard, which can only read views.
DASHBOARD_DATABASE_URL=

# --- OAuth token encryption (Milestone 6) ---
# Versioned AES-256-GCM key ring for stored OAuth tokens: 1:<base64url 32-byte key>,...
# Keep it in GitHub/Streamlit secrets only. It is never stored in the database, and a
# lost key cannot be recovered: affected connections must be reauthorised.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_ACTIVE_VERSION=

# --- Google Ads API app credentials (read-only use) ---
# Google's OAuth scope has no read-only variant, so read-only use is enforced in code.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# --- Legacy single-account settings (deprecated) ---
# Accounts and tokens now come from per-account OAuth connections. These are unused by
# the multi-account path and will be removed once it is proven. Leave them blank.
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
