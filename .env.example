# Copy to .env and fill in only what you need. Never commit .env.
# The synthetic-data path runs with every credential below left blank.

# --- Application ---
# local | test | ci | production
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# synthetic | live (live requires the Google Ads and Meta values below)
DATA_SOURCE=synthetic

# --- Anthropic API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Supabase PostgreSQL ---
# Use the Session pooler string from the dashboard's Connect panel (it works over IPv4),
# with the user replaced by a GrowthPulse role. URL-encode special characters in the
# password. sslmode=require is added when missing, and weaker modes are refused.
# require_auth=scram-sha-256 is always added, and other authentication methods are
# refused. For production, use sslmode=verify-full with sslrootcert set to Supabase's CA.
# Never put the postgres user or any Supabase API key here: the app refuses other roles.
#
# Backend. Must log in as growthpulse_writer. Used by the pipeline only. Shape:
#   postgresql://growthpulse_writer.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=
# Dashboard. Must log in as growthpulse_dashboard, which can only read views.
DASHBOARD_DATABASE_URL=

# --- Google Ads API (read-only use) ---
# Google's OAuth scope has no read-only variant, so authorize with a Google
# user that has "Read only" access to the ads account.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional: manager account ID, when access goes through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta Marketing API (read-only use) ---
# Grant the ads_read permission only. Do not grant ads_management.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
